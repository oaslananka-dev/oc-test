[Unit]
Description=Bounded Multica to GitHub OpenCode fleet dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/oc-fleet-dispatch
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/flock -n %h/.local/state/oc-fleet/dispatch.lock /usr/bin/python3 .github/scripts/oc_fleet_multica_poll.py --project-id 0506e0e5-01a7-4de9-b63b-67e993809721 --run --max-parallel 2 --repair-pilot-pr2
TimeoutStartSec=40min
NoNewPrivileges=true
